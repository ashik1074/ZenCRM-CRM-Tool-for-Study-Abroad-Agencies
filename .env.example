# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres connection (Project Settings → Database → Connection string → "Session pooler" or direct) ---
# Used by migrations, seed, and the AI assistant's read-only query runner.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Anthropic (server only; optional until you use the AI assistant) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Minutes of inactivity before automatic logout
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=60
